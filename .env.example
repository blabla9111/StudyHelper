# Путь к файлу базы SQLite (по умолчанию ./data/studyhelper.db)
DATABASE_PATH=./data/studyhelper.db

# Демо-аккаунты на странице входа. В разработке (npm run dev) блок виден сам.
# На боевом сервере по умолчанию скрыт; DEMO_MODE=false выключает его всегда, даже если задан NEXT_PUBLIC_DEMO.
# Только для показа на конкурсе раскомментируйте обе строки (демо-сид в боевом режиме иначе откажется работать):
# DEMO_MODE=true
# ALLOW_DEMO_SEED=true

# Cookie сессии с флагом Secure: в боевом режиме (NODE_ENV=production) включён сам.
# Ставьте false только если сайт открыт по обычному http (например, проверка на localhost через npm start).
COOKIE_SECURE=true

# Настоящий адрес сайта, например https://studyhelper-demo.ru. Нужен для QR-кода в справках
# и для проверки Origin. На боевом сервере обязателен: без него адрес берётся из заголовков запроса.
PUBLIC_BASE_URL=

# Сколько обратных прокси стоит перед приложением (Caddy/nginx = 1).
# Адрес клиента берётся из X-Forwarded-For с конца цепочки; прокси обязан перезаписывать этот заголовок.
# 0 — приложение открыто напрямую, заголовку не доверяем.
TRUSTED_PROXY_HOPS=1
