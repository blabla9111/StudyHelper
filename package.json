{
  "name": "studyhelper",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx scripts/seed.ts --if-empty && next dev",
    "build": "next build",
    "start": "tsx scripts/seed.ts --if-empty --production && next start",
    "seed": "tsx scripts/seed.ts --reset",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "typecheck": "tsc --noEmit",
    "check:security": "node scripts/check-security.mjs",
    "check:flows": "node scripts/check-flows.mjs",
    "check:features": "node scripts/check-features.mjs",
    "check:messages": "node scripts/check-messages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
